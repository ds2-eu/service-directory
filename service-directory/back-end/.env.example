# Service Directory API
PORT=3002
SERVER=http://localhost:3002

# Keycloak (optional for local development)
SECURITY_ENABLED=false
AUTH_URL=http://localhost:8080
REALM=Orchestration
CLIENT_ID=service-directory-api
CLIENT_SECRET=replace-me

# Shared Objects Repository persistence
REPOSITORY_API_URL=https://dlmstorebackend.idta.ds2.icelab.cloud/repository-api
REPOSITORY_OWNER_ID=service-directory
REPOSITORY_API_KEY=replace-with-the-repository-api-key
